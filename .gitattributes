# Text files keep LF endings on every checkout, as they are in this folder.
* text=auto eol=lf

# The Claude Code Game Studios hooks run in bash, which breaks on CRLF.
*.sh text eol=lf
*.awk text eol=lf

# Binary assets
*.pdf binary
*.glb binary
*.png binary
*.blend binary

# The avatar and the soft furnishings are base64 data inside .js files: never diff them.
dao-model-*.js -diff
dao-soft.js -diff
